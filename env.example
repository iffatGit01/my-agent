# Copy this file to ".env" and fill in ONE of the options below.
# Only needed when running the real agent (AGENT_MODE=real). The Playwright tests don't need it.

# ---------------------------------------------------------------
# OPTION 1 (free): GitHub Models
# ---------------------------------------------------------------
LLM_PROVIDER=github
GITHUB_TOKEN=paste-your-github-token-here
# Optional. Pick any chat model from https://github.com/marketplace/models
# LLM_MODEL=openai/gpt-4.1-mini

# ---------------------------------------------------------------
# OPTION 2 (free, offline): Ollama on your own computer
# ---------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# ---------------------------------------------------------------
# OPTION 3 (needs Azure subscription): Azure AI Foundry
# ---------------------------------------------------------------
# LLM_PROVIDER=azure
# AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
