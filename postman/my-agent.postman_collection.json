    {
      "name": "4. Chat - real agent (optional)",
      "description": "Server must run with AGENT_MODE=real",
      "item": [
        {
          "name": "Real agent - weather",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has a text reply\", () => { const j = pm.response.json(); pm.expect(j.reply).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Reply mentions 22\", () => pm.expect(pm.response.json().reply).to.include(\"22\"));",
                  "pm.test(\"Responds in under 90000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(90000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Needs AGENT_MODE=real. Wording varies, so only the tool fact (22) is checked. Real models can be slow.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What's the weather in Tokyo?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Real agent - arithmetic",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has a text reply\", () => { const j = pm.response.json(); pm.expect(j.reply).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Answer contains 42\", () => pm.expect(pm.response.json().reply).to.match(/42/));",
                  "pm.test(\"Responds in under 90000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(90000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
