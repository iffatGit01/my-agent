{
  "info": {
    "_postman_id": "76d64a22-3df1-4bf4-b9ff-8912b8613ce2",
    "name": "My Agent API",
    "description": "API tests for the My Agent FastAPI server.\n\nFor repeatable results start the server in fake mode:\n$env:AGENT_MODE=\"fake\"; $env:SEARCH_FAKE=\"1\"; $env:BROWSER_ALLOW_LOCAL=\"1\"\nuvicorn agent_app.server:app --port 8000\n\nRun folders 1-3 in fake mode. Run folder 4 only with AGENT_MODE=real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Basics",
      "description": "",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responds in under 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.test(\"Body is {status: ok}\", () => pm.expect(pm.response.json()).to.eql({status: \"ok\"}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Used by monitoring and by the test suite to know the server is up."
          }
        },
        {
          "name": "Chat page (HTML)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Is an HTML page\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));",
                  "pm.test(\"Contains the app title\", () => pm.expect(pm.response.text()).to.include(\"My Agent\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "Static file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/static/index.html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "static",
                "index.html"
              ]
            }
          }
        },
        {
          "name": "OpenAPI schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Documents POST /chat\", () => pm.expect(pm.response.json().paths).to.have.property(\"/chat\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.json"
              ]
            },
            "description": "FastAPI generates this automatically. You can also import it into Postman: Import > Link."
          }
        }
      ]
    },
    {
      "name": "2. Chat - fake agent (deterministic)",
      "description": "Server must run with AGENT_MODE=fake",
      "item": [
        {
          "name": "Weather tool",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has a text reply\", () => { const j = pm.response.json(); pm.expect(j.reply).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Reply mentions Weather in Dhaka\", () => pm.expect(pm.response.json().reply).to.include(\"Weather in Dhaka\"));",
                  "pm.test(\"Reply mentions 32\", () => pm.expect(pm.response.json().reply).to.include(\"32\"));",
                  "pm.test(\"Responds in under 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What's the weather in Dhaka?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Weather - unknown city",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reply mentions no weather data\", () => pm.expect(pm.response.json().reply).to.include(\"no weather data\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"weather in Atlantis\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add tool",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reply is exactly: The sum is 42\", () => pm.expect(pm.response.json().reply).to.eql(\"The sum is 42\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
