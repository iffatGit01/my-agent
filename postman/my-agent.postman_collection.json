          }
        },
        {
          "name": "Browsing blocks private addresses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reply mentions Blocked\", () => pm.expect(pm.response.json().reply).to.include(\"Blocked\"));",
                  "pm.test(\"No metadata leaked\", () => pm.expect(pm.response.json().reply).to.not.include(\"ami-id\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Security check: the agent must refuse cloud-metadata / private addresses.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"open http://169.254.169.254/latest/meta-data\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Agent failure returns 500",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 500\", () => pm.response.to.have.status(500));",
                  "pm.test(\"Error message is returned\", () => pm.expect(pm.response.json().error).to.include(\"simulated agent failure\"));",
                  "pm.test(\"No stack trace leaked\", () => pm.expect(pm.response.text()).to.not.include(\"Traceback\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"boom\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
